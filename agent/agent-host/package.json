{
  "name": "@dqa-ai-solutions/agent-host",
  "version": "0.1.0",
  "description": "Agent host: FieldApp.load(pack).run(case), FieldSession, CommandSet, capability grants, trace ledger and the dqa-fos CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DQASolutions/agent-runtime.git",
    "directory": "agent/agent-host"
  },
  "homepage": "https://github.com/DQASolutions/agent-runtime#readme",
  "bugs": {
    "url": "https://github.com/DQASolutions/agent-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "bin": {
