    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@dqa-ai-solutions/core-runtime": "^0.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@dqa-ai-solutions/ontology-runtime": "^0.2.0"
  },
  "private": true,
  "peerDependencies": {
    "@dqa-ai-solutions/core-runtime": "^0.2.0",
    "@dqa-ai-solutions/ontology-runtime": "^0.2.0"
  }
